msgid "Drag to place. SHIFT+B when done."
msgstr "Drag to place. SHIFT+B when done."

msgid "Live XP bars"
msgstr "Live XP bars"

msgid "Bars"
msgstr "Bars"

msgid "Enabled"
msgstr "Enabled"

msgid "Bars of the skills being trained right now. SHIFT+B - move them."
msgstr "Bars of the skills being trained right now. SHIFT+B - move them."

msgid "Hold, seconds"
msgstr "Hold, seconds"

msgid "How long a bar stays after experience is gained."
msgstr "How long a bar stays after experience is gained."

