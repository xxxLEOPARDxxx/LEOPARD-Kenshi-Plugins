msgid "Factions that live on their own: a new faction with its own name appears in the Hub, earns money, recruits and grows in tech. When all its members are dead it is gone."
msgstr "Фракции, которые живут сами: в Хабе появляется новая фракция со своим названием, зарабатывает, нанимает людей и растёт в технике. Когда все её члены погибли - её больше нет."

msgid "General"
msgstr "Общие"

msgid "Enabled"
msgstr "Включено"

msgid "The whole mod."
msgstr "Весь мод."

msgid "Faction window key"
msgstr "Клавиша окна фракций"

msgid "Opens and closes the window with the state of the factions. Click and press a key; Backspace - no key."
msgstr "Открывает и закрывает окно с состоянием фракций. Щёлкните и нажмите клавишу; Backspace - без клавиши."

msgid "Diagnostics"
msgstr "Диагностика"

msgid "Detailed log"
msgstr "Подробный журнал"

msgid "Details in RE_Kenshi_log.txt: every hourly tick of a faction, saving and loading."
msgstr "Подробности в RE_Kenshi_log.txt: каждый часовой ход фракции, сохранение и загрузка."

msgid "Day %d, %02d:00"
msgstr "День %d, %02d:00"

msgid "Founded in the Hub"
msgstr "Основана в Хабе"

msgid "Recruited a new member"
msgstr "Наняла нового человека"

