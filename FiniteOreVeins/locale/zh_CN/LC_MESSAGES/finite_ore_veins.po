msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: zh_CN\n"

msgid "Depleted"
msgstr "已枯竭"

msgid "Recovering"
msgstr "恢复中"

msgid "Ore remaining"
msgstr "剩余矿石"

msgid "Ore deposits"
msgstr "矿脉"

msgid "Enable plugin"
msgstr "启用插件"

msgid "Limits natural ore veins, including compatible modded veins."
msgstr "限制天然矿脉储量，包括兼容模组添加的矿脉。"

msgid "Ore at 100% quality"
msgstr "品质为 100% 时的储量"

msgid "Base reserve in units per natural vein."
msgstr "每条天然矿脉的基础矿石储量。"

msgid "Scale reserve by quality"
msgstr "按品质调整储量"

msgid "A vein at 80% quality holds 80% of the base reserve."
msgstr "品质为 80% 的矿脉拥有基础储量的 80%。"

msgid "Recovery"
msgstr "恢复"

msgid "Days to refill"
msgstr "完全恢复所需天数"

msgid "Game days to refill after the delay. 0 disables recovery."
msgstr "等待结束后完全恢复所需的游戏天数。0 表示关闭恢复。"

msgid "Hours before recovery"
msgstr "恢复前等待小时数"

msgid "Delay after the last unit was mined, in game hours."
msgstr "最后一次开采后的等待时间，以游戏小时计。"

msgid "Reopen at (%)"
msgstr "重新开放的储量 (%)"

msgid "An exhausted vein stays closed until this share is restored. 0 reopens at one unit."
msgstr "枯竭的矿脉恢复至此比例后开放。设为 0 时，恢复一单位矿石即开放。"

msgid "Diagnostics"
msgstr "诊断"

msgid "Detailed log"
msgstr "详细日志"

msgid "Writes diagnostic messages for the plugin. Errors are always logged."
msgstr "记录插件诊断消息。错误始终记录。"
