msgid "Stops observed crowd-push entry through closed player gates and doors. Independently authored; use instead of Gate Push Fix."
msgstr "Stops observed crowd-push entry through closed player gates and doors. Independently authored; use instead of Gate Push Fix."

msgid "Protection"
msgstr "Protection"

msgid "Enabled"
msgstr "Enabled"

msgid "Return a character only after an observed outside-to-inside crossing through a continuously closed player door. Existing occupants and gate closure are never enough to move anyone."
msgstr "Return a character only after an observed outside-to-inside crossing through a continuously closed player door. Existing occupants and gate closure are never enough to move anyone."

msgid "Diagnostics"
msgstr "Diagnostics"

msgid "Detailed log"
msgstr "Detailed log"

msgid "Log recognized door geometry and corrected crossings in RE_Kenshi_log.txt. Errors are always logged."
msgstr "Log recognized door geometry and corrected crossings in RE_Kenshi_log.txt. Errors are always logged."
