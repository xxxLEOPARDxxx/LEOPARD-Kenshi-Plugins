# Gate Push Guard, independently authored by LEOPARD. GPL-3.0-or-later.
msgid ""
msgstr "Language: zh_CN\nContent-Type: text/plain; charset=UTF-8\nMIME-Version: 1.0\n"

msgid "Stops observed crowd-push entry through closed player gates and doors. Independently authored; use instead of Gate Push Fix."
msgstr "阻止观察到的角色被人群推过玩家关闭的大门和房门。独立编写；请用它替代 Gate Push Fix。"

msgid "Protection"
msgstr "保护"

msgid "Enabled"
msgstr "启用"

msgid "Return a character only after an observed outside-to-inside crossing through a continuously closed player door. Existing occupants and gate closure are never enough to move anyone."
msgstr "仅在观察到角色从外侧穿过持续关闭的玩家房门进入内侧时将其送回。原本就在内侧或关门本身都不会导致角色被移动。"

msgid "Diagnostics"
msgstr "诊断"

msgid "Detailed log"
msgstr "详细日志"

msgid "Log recognized door geometry and corrected crossings in RE_Kenshi_log.txt. Errors are always logged."
msgstr "将识别到的门几何和纠正的穿门事件写入 RE_Kenshi_log.txt。错误始终记录。"
