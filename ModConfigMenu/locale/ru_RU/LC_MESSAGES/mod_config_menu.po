msgid "Mods"
msgstr "Моды"

msgid "No mods with settings were found."
msgstr "Модов с настройками не найдено."

msgid "* Takes effect after the game is restarted."
msgstr "* Вступит в силу после перезапуска игры."

msgid "Reset to defaults"
msgstr "Сбросить по умолчанию"

msgid "Press a key... Backspace - none"
msgstr "Нажмите клавишу... Backspace - нет"

msgid "none"
msgstr "нет"

msgid "Press a key... Backspace - none, Esc - cancel"
msgstr "Нажмите клавишу... Backspace - нет, Esc - отмена"

msgid "Press a key... Backspace - none, click - cancel"
msgstr "Нажмите клавишу... Backspace - нет, щелчок - отмена"

msgid "Palette"
msgstr "Палитра"

msgid "Hide"
msgstr "Скрыть"

msgid "Current colour"
msgstr "Текущий цвет"

msgid "Default"
msgstr "По умолчанию"

msgid "Switch between the palette and typing the colour code (#RRGGBB)"
msgstr "Переключить: палитра или ввод кода цвета (#RRGGBB)"

msgid "Show or hide the colours to pick from"
msgstr "Показать или скрыть цвета для выбора"

msgid "Settings of the mods in this tab."
msgstr "Настройки модов в этой вкладке."

msgid "Diagnostics"
msgstr "Диагностика"

msgid "Detailed log"
msgstr "Подробный журнал"

msgid "Details in RE_Kenshi_log.txt: which mods were found and what was written."
msgstr "Подробности в RE_Kenshi_log.txt: какие моды найдены и что записано."
