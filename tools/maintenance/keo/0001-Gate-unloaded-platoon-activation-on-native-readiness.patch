+ReadinessLoadedBTOriginal g_readinessLoadedBTOriginal = NULL;
+namespace {
+static bool s_activationHookInstalled=false,s_activationProfile=false;
+static uintptr_t s_activationReturn=0,s_nativeNavSlot=0;
+
+static bool ReadinessActivationProfile()
+{
+    // Exact native getter, eligible-platoon call/test and public thunk. These
+    // are startup-only checks on the pinned executable, before either hook.
+    struct W {uintptr_t rva;size_t bytes;unsigned char data[16];};
+    const W windows[]={
+    {0xA0C360,16,{0x40,0x53,0x48,0x83,0xEC,0x20,0x48,0x8B,0xD9,0x48,0x85,0xC9,0x75,0x08,0x32,0xC0}},
+    {0x7EB406,16,{0x48,0x8B,0xCB,0xE8,0x06,0xD4,0x81,0xFF,0x84,0xC0,0x74,0x6C,0xF3,0x0F,0x10,0x15}},
+    {0x8814,5,{0xE9,0x47,0x3B,0xA0,0x00}},
+    };
+    unsigned char actual[16];
+    for(size_t i=0;i<sizeof(windows)/sizeof(windows[0]);++i)
+        if(!ReadinessPollBytes(NULL,windows[i].rva,actual,windows[i].bytes)
+            ||std::memcmp(actual,windows[i].data,windows[i].bytes)!=0)return false;
+    return true;
+}
+}
+void ReadinessActivationFinalize(bool installed){s_activationHookInstalled=installed&&g_readinessLoadedBTOriginal!=NULL;}
+bool hook_isLoadedBT(void*zone)
+{
+    const uintptr_t caller=reinterpret_cast<uintptr_t>(_ReturnAddress());
+    const bool result=g_readinessLoadedBTOriginal(zone);
+    // Only the native unloaded-platoon eligibility check is narrowed. Other
+    // isLoadedBT consumers retain their answer; the original lock has already
+    // been released before taking the navmesh getter's own locks.
+    if(!result||caller!=s_activationReturn
+        ||InterlockedCompareExchange(&s_readinessPollReady,0,0)==0
+        ||!zone::g_zoneCfg.deferralEnabled||!zone::g_zoneCfg.readinessOverridesEnabled)return result;
+    if(!zone||!s_nativeNavSlot||!game::g_hookOrig.orig_isContentPending)return false;
+    void*manager=*reinterpret_cast<void**>(s_nativeNavSlot);
+    if(!manager)return false;
+    InterlockedIncrement(&s_activationChecks);
+    // Bypass our public readiness detour: population must see the unmodified
+    // native readiness, even inside any nested loading-poll TLS scope.
+    const bool ready=game::g_hookOrig.orig_isContentPending(manager,ZoneReadinessPoll::ZoneCoords(zone));
+    if(!ready)InterlockedIncrement(&s_activationWaits);
+    return ready;
+}
