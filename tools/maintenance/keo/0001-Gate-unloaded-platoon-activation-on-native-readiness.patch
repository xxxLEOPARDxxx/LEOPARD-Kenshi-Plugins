@@ -0,0 +1,66 @@
+"""Compile the actual loaded-BT guard; missing hook reproduces native early activation."""
+from pathlib import Path
+import os,sys,subprocess,hashlib
+sys.dont_write_bytecode=True
+root=Path(__file__).resolve().parents[1];out=root/'build/leopard-activation-readiness';out.mkdir(parents=True,exist_ok=True)
+source=(root/'src/zone/readiness/readiness_hook.cpp').read_text(encoding='utf-8')
+def body(marker):
+ start=source.index(marker);end=source.index('{',start)+1;depth=1
+ while depth:depth+=(source[end]=='{')-(source[end]=='}');end+=1
+ return source[start:end]
+missing='bool hook_isLoadedBT(' not in source
+code='bool hook_isLoadedBT(void*zone){return g_readinessLoadedBTOriginal(zone);}' if missing else body('bool hook_isLoadedBT(').replace('_ReturnAddress()','TestReturnAddress()')
+prefix=r"""
+#define WIN32_LEAN_AND_MEAN
+#include <Windows.h>
+#include <stdint.h>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <new>
+static unsigned checks=0;static LONG allocs=0;
+void*operator new(size_t n){InterlockedIncrement(&allocs);void*p=malloc(n);if(!p)throw std::bad_alloc();return p;}
+void*operator new[](size_t n){return ::operator new(n);}void operator delete(void*p){free(p);}void operator delete[](void*p){free(p);}
+static void C(bool b,const char*s){++checks;if(!b){printf("FAIL %s\n",s);exit(1);}}
+namespace zone{struct Cfg{bool deferralEnabled,readinessOverridesEnabled;}g_zoneCfg={true,true};}
+namespace ZoneReadinessPoll{void*ZoneCoords(void*z){return z?(void*)((uintptr_t)z+24):NULL;}}
+static volatile LONG s_readinessPollReady=1;
+static uintptr_t s_activationReturn=0x1407EB40EULL,s_nativeNavSlot=0;
+static uintptr_t actualReturn=s_activationReturn;
+static void*TestReturnAddress(){return(void*)actualReturn;}
+static bool btReady=true,navReady=false;static unsigned btCalls=0,navCalls=0;static void*expectedZone=NULL,*expectedNav=NULL;
+static bool OriginalBT(void*z){++btCalls;C(z==expectedZone,"exact original zone");return btReady;}
+static bool OriginalNav(void*m,void*c){++navCalls;C(m==expectedNav&&c==ZoneReadinessPoll::ZoneCoords(expectedZone),"native getter receives same zone coords and manager");return navReady;}
+typedef bool(*ReadinessLoadedBTOriginal)(void*);
+static ReadinessLoadedBTOriginal g_readinessLoadedBTOriginal=OriginalBT;
+namespace game{struct Orig{bool(*orig_isContentPending)(void*,void*);}g_hookOrig={OriginalNav};}
+static volatile LONG s_activationWaits=0,s_activationChecks=0;
+"""
+suffix=r"""
+int main(){
+ unsigned char zoneData[64]={};int manager=0;void*nav=&manager;s_nativeNavSlot=(uintptr_t)&nav;expectedNav=nav;expectedZone=zoneData;
+ C(!hook_isLoadedBT(zoneData),"loaded flag must NOT activate platoon before native navmesh readiness");
+ C(btCalls==1&&navCalls==1,"one original plus one native readiness check");
+ for(unsigned enabled=0;enabled<2;++enabled)for(unsigned def=0;def<2;++def)for(unsigned over=0;over<2;++over)for(unsigned caller=0;caller<2;++caller)for(unsigned bt=0;bt<2;++bt)for(unsigned ready=0;ready<2;++ready){
+  s_readinessPollReady=enabled;zone::g_zoneCfg.deferralEnabled=def!=0;zone::g_zoneCfg.readinessOverridesEnabled=over!=0;actualReturn=caller?s_activationReturn:0x140123456ULL;btReady=bt!=0;navReady=ready!=0;
+  unsigned bc=btCalls,nc=navCalls;LONG ac=allocs;bool guarded=enabled&&def&&over&&caller&&bt;
+  C(hook_isLoadedBT(zoneData)==(bt&&(!guarded||ready)),"caller/options/native-ready truth table");C(btCalls==bc+1,"original exactly once");C(navCalls==nc+(guarded?1:0),"no navmesh query for unrelated callers or native false");C(allocs==ac,"zero per-call allocations");
+ }
+ s_readinessPollReady=1;zone::g_zoneCfg.deferralEnabled=zone::g_zoneCfg.readinessOverridesEnabled=true;actualReturn=s_activationReturn;btReady=true;navReady=false;
+ nav=NULL;C(!hook_isLoadedBT(zoneData),"missing live manager keeps platoon unloaded");nav=&manager;
+ s_nativeNavSlot=0;C(!hook_isLoadedBT(zoneData),"missing manager slot keeps platoon unloaded");s_nativeNavSlot=(uintptr_t)&nav;
+ game::g_hookOrig.orig_isContentPending=NULL;C(!hook_isLoadedBT(zoneData),"missing native readiness function keeps platoon unloaded");game::g_hookOrig.orig_isContentPending=OriginalNav;
+ expectedZone=NULL;C(!hook_isLoadedBT(NULL),"null target retains no admission");expectedZone=zoneData;
+ printf("PASS %u activation checks; native wait, original once, options, no allocation\n",checks);return 0;
+}
+"""
+(out/'guard.cpp').write_text(prefix+code+suffix)
+vc=Path('C:/Program Files (x86)/Microsoft Visual Studio 10.0/VC');sdk=Path('C:/Program Files/Microsoft SDKs/Windows/v7.1')
+env=dict(os.environ,INCLUDE=f'{vc}/include;{sdk}/Include',LIB=f'{vc}/lib/amd64;{sdk}/Lib/x64')
+for opt in ['/Od','/O2']:
+ exe=out/('guard-'+opt[1:]+'.exe');p=subprocess.run([str(vc/'bin/amd64/cl.exe'),'/nologo','/EHsc','/MT',opt,str(out/'guard.cpp'),'/Fo'+str(out)+'/', '/Fe'+str(exe)],cwd=out,env=env,capture_output=True,text=True)
+ if p.returncode:print(p.stdout+p.stderr);raise SystemExit(p.returncode)
+ p=subprocess.run([str(exe)],capture_output=True,text=True);(out/('guard-'+opt[1:]+'-run.log')).write_text(p.stdout+p.stderr);print(p.stdout,end='',flush=True)
+ if '--expect-red' in sys.argv:assert p.returncode==1 and 'loaded flag must NOT activate platoon' in p.stdout
+ else:assert not missing and p.returncode==0,(missing,p.returncode,p.stderr)
+print('source',hashlib.sha256(source.encode()).hexdigest(),'legacy/no-hook',missing)
