diff --git a/src/pathfind/path_budget_policy.cpp b/src/pathfind/path_budget_policy.cpp
new file mode 100644
index 0000000..c9d3f37
--- /dev/null
+++ b/src/pathfind/path_budget_policy.cpp
@@ -0,0 +1,40 @@
+#include "pathfind/path_budget_policy.h"
+#include <cstring>
+
+void PathBudgetEnter(PathBudgetFrame* frame, PathBudgetRequest*& slot, void* request, int priority, bool nativeNpc)
+{
+	frame->previous = slot;
+	frame->current.request = request;
+	frame->current.priority = priority;
+	frame->current.nativeNpc = nativeNpc;
+	frame->current.consumed = false;
+	slot = &frame->current;
+}
+void PathBudgetLeave(const PathBudgetFrame* frame, PathBudgetRequest*& slot) { slot = frame->previous; }
+
+bool PathBudgetTake(PathBudgetRequest* current, AstarCallerClass caller, PathBudgetDecision* out)
+{
+	if (!out) return false;
+	out->request = NULL;
+	out->playerByReq = -1;
+	out->expand = false;
+	if (caller != ASTAR_CALLER_CHARACTER_UNKNOWN || !current || current->consumed || !current->request) return false;
+	current->consumed = true;
+	out->request = current->request;
+	out->playerByReq = current->priority >= 20 ? 1 : 0;
+	// The native owner flag positively identifies a resolved player. Priority
+	// remains the author's routing/diagnostic label, not the budget decision.
+	out->expand = !current->nativeNpc;
+	return true;
+}
+
+bool PathBudgetApply(void* input, bool expand)
+{
+	if (!input || !expand) return false;
+	const int openBytes = 131072 * 4;
+	const int stateBytes = 590336 * 4;
+	unsigned char* p = static_cast<unsigned char*>(input);
+	std::memcpy(p + 156, &openBytes, sizeof(openBytes));
+	std::memcpy(p + 160, &stateBytes, sizeof(stateBytes));
+	return true;
+}
diff --git a/src/pathfind/path_budget_policy.h b/src/pathfind/path_budget_policy.h
new file mode 100644
index 0000000..30d96dd
--- /dev/null
+++ b/src/pathfind/path_budget_policy.h
@@ -0,0 +1,34 @@
+#pragma once
+#include "pathfind/astar_cost_policy.h"
+
+// One synchronous native fallback invocation, on its original calling thread.
+// The scope owns these scalars; no request pointer survives its return/unwind.
+struct PathBudgetRequest
+{
+	void* request;
+	int priority;
+	bool nativeNpc, consumed;
+};
+struct PathBudgetDecision
+{
+	void* request;
+	int playerByReq;
+	bool expand;
+};
+struct PathBudgetFrame
+{
+	PathBudgetRequest current;
+	PathBudgetRequest* previous;
+};
+// POD frame so the native caller can restore through __finally for both C++
+// and native unwinds under /EHsc, without allocating or swallowing a fault.
+void PathBudgetEnter(PathBudgetFrame* frame, PathBudgetRequest*& slot, void* request, int priority, bool nativeNpc);
+void PathBudgetLeave(const PathBudgetFrame* frame, PathBudgetRequest*& slot);
+
+// Call with the caller classification made WITHOUT a request tag. Only the
+// audited character site returns CHARACTER_UNKNOWN; other sites cannot borrow
+// or consume this request. Each current invocation can be consumed only once.
+bool PathBudgetTake(PathBudgetRequest* current, AstarCallerClass caller, PathBudgetDecision* out);
+// Exact original KEO four-times sizes, no allocations or traversal changes.
+// false/null is byte-for-byte pass-through of native inputs.
+bool PathBudgetApply(void* input, bool expand);
