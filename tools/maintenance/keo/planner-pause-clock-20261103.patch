@@ -14,6 +14,12 @@
 namespace planner {
 namespace planner_tick_detail {
 
+// Main thread only. All planner behavioral ages share the existing order-outcome
+// active clock. Pass raw ElapsedSec/frame time once, never an already active value.
+// Wall-time cadence, diagnostic intervals and native async completion clocks stay
+// separate. The shared clock survives load; generation reset retires old plans.
+double BehaviorNow(double rawNow);
+
 // A located point: its store node and section, and whether the engine's own face lookup found it.
 struct Located { unsigned key; int dir; int uid; int node; int exact; };
 
