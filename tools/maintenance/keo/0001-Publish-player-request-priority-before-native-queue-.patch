+DWORD WINAPI Worker(void*p){Harness*h=static_cast<Harness*>(p);if(WaitForSingleObject(h->publish,10000)!=WAIT_OBJECT_0)return 3;Observe(h);SetEvent(h->done);return 0;}
+void OriginalEnqueue(void*queue,void**item)
+{
