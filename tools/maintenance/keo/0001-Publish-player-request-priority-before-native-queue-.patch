+ __except(GetExceptionCode()==EXCEPTION_ACCESS_VIOLATION||GetExceptionCode()==0xe0424242?EXCEPTION_EXECUTE_HANDLER:EXCEPTION_CONTINUE_SEARCH){return GetExceptionCode();}
+}
