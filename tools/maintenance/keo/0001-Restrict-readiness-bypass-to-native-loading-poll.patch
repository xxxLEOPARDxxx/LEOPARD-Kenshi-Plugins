@@ -0,0 +1,21 @@
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+
+// Pure policy only. Caller owns the TLS Context and restores a POD Frame in
+// __finally. No native object is dereferenced by this component. Native return
+// addresses supplied to Enter/Take are absolute addresses; constants below are
+// Steam RVAs. Capability/Profile are startup gates, never per-getter work.
+namespace ZoneReadinessPoll {
+enum { WrapperRva=0x3AC810,LoadingPollReturn=0xA0EA90,CoordsReturn=0x3AC822 };
+struct Context {void*manager;void*coords;uintptr_t expectedReturn;bool admitted,consumed;};
+struct Frame {Context current,previous;};
+void Enter(Context&tls,Frame&frame,void*manager,void*coords,uintptr_t expectedReturn,bool admitted);
+void Leave(Context&tls,const Frame&frame);
+// First attempt is consumed even on mismatch, before invoking the original.
+bool Take(Context&tls,void*manager,void*coords,uintptr_t actualReturn);
+void* ZoneCoords(void*zone);
+typedef bool (*Reader)(void*user,uintptr_t rva,unsigned char*out,size_t bytes);
+bool Profile(Reader reader,void*user);
+bool Capability(bool wanted,bool profile,bool coordsHook,bool wrapperHook,bool origCoords,bool origWrapper);
+}
