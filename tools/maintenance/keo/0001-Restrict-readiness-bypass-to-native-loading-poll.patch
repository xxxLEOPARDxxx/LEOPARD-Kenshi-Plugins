+#include "zone/readiness/zone_readiness_poll_scope.h"
+#include <string.h>
+namespace ZoneReadinessPoll {
+void Enter(Context&tls,Frame&frame,void*manager,void*coords,uintptr_t expectedReturn,bool admitted)
+{
+ frame.previous=tls;
+ frame.current.manager=manager;frame.current.coords=coords;frame.current.expectedReturn=expectedReturn;
+ frame.current.admitted=admitted;frame.current.consumed=false;
+ // Every entry replaces the outer context, including unadmitted entries.
+ tls=frame.current;
+}
+void Leave(Context&tls,const Frame&frame){tls=frame.previous;}
+bool Take(Context&tls,void*manager,void*coords,uintptr_t actualReturn)
+{
+ const bool match=tls.admitted&&!tls.consumed&&tls.manager&&tls.coords&&tls.expectedReturn&&manager&&coords&&actualReturn
+  &&tls.manager==manager&&tls.coords==coords&&tls.expectedReturn==actualReturn;
+ // Burn the first attempt before the caller invokes the original getter.
+ // A mismatch must not donate an outer permit to a nested native query.
+ tls.consumed=true;
+ return match;
+}
+void* ZoneCoords(void*zone)
+{
+ const uintptr_t address=reinterpret_cast<uintptr_t>(zone);
+ return address&&address<=~uintptr_t(0)-24?reinterpret_cast<void*>(address+24):NULL;
+}
+namespace {
+struct Window {uintptr_t rva;size_t bytes;unsigned char data[36];};
+const Window Windows[]={
+ {0x3AC810,36,{0x48,0x83,0xec,0x28,0x48,0x85,0xd2,0x74,0x14,0x48,0x83,0xc2,0x18,0xe8,0xcb,0x4f,0xc6,0xff,0x84,0xc0,0x74,0x07,0xb0,0x01,0x48,0x83,0xc4,0x28,0xc3,0x32,0xc0,0x48,0x83,0xc4,0x28,0xc3}},
+ {0x3AB4F0,16,{0x40,0x55,0x56,0x57,0x41,0x54,0x41,0x55,0x48,0x81,0xec,0xb0,0x00,0x00,0x00,0x48}},
+ {0x53986,5,{0xe9,0x85,0x8e,0x35,0x00}},
+ {0x117ED,5,{0xe9,0xfe,0x9c,0x39,0x00}},
+ {0xA0EA35,13,{0x83,0xbe,0xd8,0x81,0x16,0x00,0x04,0x0f,0x85,0xe7,0x00,0x00,0x00}},
+ {0xA0EA80,32,{0x48,0x8b,0x53,0x10,0x48,0x8b,0x0d,0xd5,0x4a,0x72,0x01,0xe8,0xf6,0x4e,0x64,0xff,0x84,0xc0,0x0f,0x84,0x91,0x00,0x00,0x00,0x48,0x8b,0x1b,0x48,0x85,0xdb,0x75,0xe0}},
+ {0xA0EAA0,17,{0xc6,0x86,0xb8,0x00,0x00,0x00,0x01,0xc7,0x86,0xd8,0x81,0x16,0x00,0x05,0x00,0x00,0x00}}
+};
+}
+bool Profile(Reader reader,void*user)
+{
+ if(!reader)return false;
+ unsigned char actual[36];
+ for(size_t i=0;i<sizeof(Windows)/sizeof(Windows[0]);++i){const Window&w=Windows[i];
+  if(!reader(user,w.rva,actual,w.bytes)||memcmp(actual,w.data,w.bytes)!=0)return false;
+ }
+ return true;
+}
+bool Capability(bool wanted,bool profile,bool coordsHook,bool wrapperHook,bool origCoords,bool origWrapper)
+{
+ return wanted&&profile&&coordsHook&&wrapperHook&&origCoords&&origWrapper;
+}
+}
