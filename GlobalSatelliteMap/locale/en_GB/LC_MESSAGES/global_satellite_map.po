msgstr ""
"Project-Id-Version: GlobalSatelliteMap development\n"
"Language: en_GB\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Satellite terrain is unavailable. Prepared terrain data is missing or does not match this game. The normal map remains visible."
msgstr "Satellite terrain is unavailable. Prepared terrain data is missing or does not match this game. The normal map remains visible."

msgid "Development terrain view with current sunlight, sky lighting, optional water and lights in loaded areas. Buildings are not included yet."
msgstr "Development terrain view with current sunlight, sky lighting, optional water and lights in loaded areas. Buildings are not included yet."

msgid "WARNING: Before rendering 4x4 tiles at 8192x8192, allow at least 24 GB free.\nUncompressed terrain data: about 23 GB."
msgstr "WARNING: Before rendering 4x4 tiles at 8192x8192, allow at least 24 GB free.\nUncompressed terrain data: about 23 GB."

msgid "Global map"
msgstr "Global map"

msgid "Satellite view"
msgstr "Satellite view"

msgid "Show prepared satellite terrain on the global map. The minimap keeps its existing map source."
msgstr "Show prepared satellite terrain on the global map. The minimap keeps its existing map source."

msgid "Sunlight"
msgstr "Sunlight"

msgid "Use the current sun direction and brightness."
msgstr "Use the current sun direction and brightness."

msgid "Sky and ambient light"
msgstr "Sky and ambient light"

msgid "Use the current sky and ambient illumination."
msgstr "Use the current sky and ambient illumination."

msgid "Diagnostics"
msgstr "Diagnostics"

msgid "Detailed log"
msgstr "Detailed log"

msgid "Write detailed diagnostics to RE_Kenshi_log.txt. Errors are always logged."
msgstr "Write detailed diagnostics to RE_Kenshi_log.txt. Errors are always logged."

msgid "Satellite terrain could not be drawn. Prepared data is retained. The normal map remains visible."
msgstr "Satellite terrain could not be drawn. Prepared data is retained. The normal map remains visible."

msgid "Water"
msgstr "Water"

msgid "Show water using the current sea level and lighting. If its resources are unavailable, terrain remains visible."
msgstr "Show water using the current sea level and lighting. If its resources are unavailable, terrain remains visible."

msgid "Torches and lamps"
msgstr "Torches and lamps"

msgid "Light terrain with existing point and spot lights in loaded areas. Unloaded areas do not gain invented lights."
msgstr "Light terrain with existing point and spot lights in loaded areas. Unloaded areas do not gain invented lights."

msgid "Existing city models"
msgstr "Existing city models"

msgid "Show existing static distant-town models. Fully loaded buildings and missing cached towns are not included in this development option."
msgstr "Show existing static distant-town models. Fully loaded buildings and missing cached towns are not included in this development option."

msgid "Development terrain view with current sunlight, sky lighting, optional water and lights in loaded areas. City models are experimental."
msgstr "Development terrain view with current sunlight, sky lighting, optional water and lights in loaded areas. City models are experimental."

msgid "Maximum map zoom, multiplier"
msgstr "Maximum map zoom, multiplier"

msgid "Increase the maximum zoom while satellite view is enabled. 1 restores the normal limit. Larger zoom does not add detail beyond the captured terrain resolution."
msgstr "Increase the maximum zoom while satellite view is enabled. 1 restores the normal limit. Larger zoom does not add detail beyond the captured terrain resolution."
